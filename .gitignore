# Build output
build/
out/
run/
logs/
.gradle/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Local-only material
private/
libs/

# Working notes for whoever is developing this, not part of the mod or its documentation.
docs/STATE.md

# Jars are ignored by default, with two exceptions:
#   * the wrapper, without which nobody can build at all;
#   * dist/, which holds the ready-to-use mod jar. Shipping the built jar is the whole
#     point of publishing this repository - otherwise anyone who just wants to play
#     would have to set up a JDK 8 toolchain and run ForgeGradle.
*.jar
!gradle/wrapper/gradle-wrapper.jar
!dist/*.jar

# Tools (compiled verification helpers)
tools/*.class
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
